# App (read at bundle time; only EXPO_PUBLIC_* values reach the client)
# 1 seeds a fictional learner, uses the scripted tutor and feeds bundled audio
# clips to the recogniser so every "speak" action works on a simulator.
EXPO_PUBLIC_DEMO=0
# Base URL of the tutor server in server/. Leave empty to use the scripted tutor.
EXPO_PUBLIC_TUTOR_URL=
# Billing backend: "storekit" (expo-iap, default) or "revenuecat".
EXPO_PUBLIC_BILLING_PROVIDER=storekit
# Public RevenueCat SDK keys, only read when the provider is "revenuecat".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server (server/.env or your host's environment; never shipped to the app)
PORT=8787
# Any AI SDK model id. Strings like "openai/gpt-5-mini" go through the Vercel
# AI Gateway and need AI_GATEWAY_API_KEY.
TUTOR_MODEL=openai/gpt-5-mini
AI_GATEWAY_API_KEY=
# Point at any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM) instead of
# the gateway. TUTOR_MODEL is then the model name that endpoint expects.
TUTOR_BASE_URL=
TUTOR_API_KEY=
