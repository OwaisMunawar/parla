{
  "expo": {
    "name": "Parla",
    "slug": "parla",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parla",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.owaismunawar.parla",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.owaismunawar.parla",
      "adaptiveIcon": {
        "backgroundColor": "#14122B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.READ_PHONE_STATE"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#14122B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Parla listens while you hold the talk button so your tutor can answer and score your pronunciation.",
          "speechRecognitionPermission": "Parla turns what you say into text, on this phone where the language is supported, so the tutor can reply and correct you."
        }
      ],
      "expo-iap",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#6C4DFF"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.owaismunawar.parla.widgets",
          "groupIdentifier": "group.com.owaismunawar.parla",
          "widgets": [
            {
              "name": "StreakWidget",
              "displayName": "Parla streak",
              "description": "Your speaking streak and what is due for review today.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withStoreKitConfig",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
