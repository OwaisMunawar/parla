{
  "name": "parla",
  "version": "0.1.0",
  "private": true,
  "description": "An AI speaking tutor for iOS and Android: on-device speech recognition, a tutor that corrects you, per-word pronunciation feedback, FSRS review and StoreKit 2 subscriptions.",
  "author": "Owais Munawwar <owais.munawar@gmail.com> (https://github.com/OwaisMunawar)",
  "license": "MIT",
  "main": "expo-router/entry",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:demo": "EXPO_PUBLIC_DEMO=1 expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "server": "npm run start --workspace @parla/server",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @parla/server",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npx expo-doctor@1.20.4",
    "e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@expo/ui": "~57.0.24",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.29",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "6.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "57.1.1",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-widgets": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "ts-fsrs": "5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.10",
    "react-native-purchases": "10.13.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-purchases"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
