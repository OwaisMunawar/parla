{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@/*": ["./../src/*"] },
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"]
}
